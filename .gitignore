.DS_Store
.local/

# Secrets and local environment
.env
.env.*
!.env.example
market-data-lab/.env

# Runtime/cache output
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.cache/
dist/
build/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Local archives and generated bundles
*.tar.gz
*.tgz
*.zip

# Large/local data products
market-data-lab/data/
data/raw/
data/processed/
data/*.db
data/*.db-*

# Design and QA screenshots are useful locally but noisy in git.
screenshots/
mockups/*.png
mockups/output/
.tmp/
logs/

# Generated data snapshots live in DB/runtime, not source control.
data/**/*.json
