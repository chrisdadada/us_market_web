{
  "name": "us-market-web",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "npm --prefix main-web run build && npm --prefix admin-web run build",
    "check": "npm run build && npm run test:frontend-typography && npm run test:frontend-style && npm run test:position && python3 -m unittest tests/test_dev_code_deploy.py && python3 -m py_compile server/auth_api.py",
    "test": "bash scripts/run_release_gate.sh",
    "test:routes": "node scripts/test_frontend_routes.mjs",
    "test:next": "node scripts/test_next_routes.mjs",
    "test:next:permissions": "node scripts/test_next_permissions.mjs",
    "test:position": "node --test tests/test_position_sizing.mjs",
    "test:frontend-typography": "node tests/test_frontend_typography.mjs",
    "test:frontend-style": "node tests/test_frontend_style_contract.mjs",
    "main:build": "npm --prefix main-web run build",
    "admin:build": "npm --prefix admin-web run build",
    "data:coverage": "python3 scripts/check_product_coverage.py",
    "mock:list": "node scripts/mock_shot.mjs list",
    "mock:shot": "node scripts/mock_shot.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
