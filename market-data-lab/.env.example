# Copy this file to .env and fill in your keys.
#
# Final data stack:
# - Polygon: intraday/daily market bars via Flat Files.
# - Nasdaq Data Link / Sharadar: fundamentals, daily prices, delisted coverage, actions, constituents.
# - FRED: macro/rates/risk series.
POLYGON_API_KEY=
POLYGON_S3_ACCESS_KEY=
POLYGON_S3_SECRET_KEY=
NASDAQ_DATA_LINK_API_KEY=
FRED_API_KEY=
DATABENTO_API_KEY=

# Store large market datasets outside the code repo.
# On this machine the external SSD is mounted at:
DATA_ROOT=/Volumes/Extreme SSD/market-data-lab/data

# Defaults used by the sample Makefile targets.
INTRADAY_START=2024-01-02
INTRADAY_END=2024-01-05
DAILY_START=2000-01-01
DAILY_END=
MACRO_START=1990-01-01
MACRO_END=

# Polygon Flat Files objects. Keep these unless Polygon changes its S3 layout.
POLYGON_S3_ENDPOINT=https://files.polygon.io
POLYGON_S3_BUCKET=flatfiles
POLYGON_STOCKS_MINUTE_PREFIX=us_stocks_sip/minute_aggs_v1
POLYGON_DOWNLOAD_WORKERS=4

# Start with these Sharadar tables. SEP can be large; test TICKERS/ACTIONS/SF1 first.
SHARADAR_TABLES=TICKERS,ACTIONS,SP500,SF1,SEP
